<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded dark card (DESIGN.md §6.2): 16dp radius, 1dp divider stroke. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bb_surface" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="@color/bb_divider" />
</shape>
