<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- v1.1: ACCESS_NOTIFICATION_POLICY is what makes the app appear in
         Settings > Apps > Special app access > Do Not Disturb access.
         Without this declaration the list never shows the app. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- v1.1: top-edge overlay that eats the notification-shade pull-down
         during a blast. Granted via Settings (Display over other apps). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- v1.1: fingerprint unlock on the red lockout screen (no-UI path). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- v1.1: SIM-state watch (TelephonyManager listener + poll). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- v1.1: voice trigger phrase listener (SpeechRecognizer). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- v1.2 (DESIGN.md §3.2): RAM kill is a normal permission, granted at
         install — no prompt, no ADB. NetWatch state permissions are normal
         too. INTERNET is declared for the DNS pipe's upstream queries (the
         bridge server itself is local sockets). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v1.2 ADB-only grants (DESIGN.md §3.2–3.4): declared so `pm grant`
         can work. All three are optional — every feature degrades to a
         no-ADB fallback when they are missing. DUMP and READ_LOGS are
         experimental tiers; the app must prove on-device that they unlock
         anything before presenting them as required. -->
    <uses-permission android:name="android.permission.DUMP" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.READ_LOGS" />
    <!-- NOTE: BIND_VPN_SERVICE is NOT a <uses-permission> — it is the
         DnsVpnService's android:permission attribute below. Declaring it
         here would be wrong. -->

    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Blast Buster"
        android:theme="@style/Theme.BlastBuster.Dark">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v1.1: red lockout screen over the lock screen while blasting.
             Excluded from recents so it cannot be swiped away there.
             NOT restyled in v1.2 — it stays red, full-screen,
             fingerprint-only (DESIGN.md §6.3). -->
        <activity
            android:name=".LockoutActivity"
            android:configChanges="orientation|screenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- v1.2 companion screens (DESIGN.md §4.7). All exported=false:
             they are opened only from inside the app. RamActivity /
             DndActivity / NetActivity / DnsActivity are owned by agents
             A/B; their classes land at merge — the entries are declared
             here now so the merge is manifest-clean. -->
        <activity
            android:name=".ram.RamActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false" />
        <activity
            android:name=".dnd.DndActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false" />
        <activity
            android:name=".net.NetActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false" />
        <activity
            android:name=".dns.DnsActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false" />
        <activity
            android:name=".bridge.BridgeActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false" />

        <!-- v1.1: device-admin component for lockNow() on trigger. -->
        <receiver
            android:name=".BlastAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".BlastService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- v1.2: companion host (Agent A). Foreground, specialUse like
             BlastService — same declared type, per DESIGN.md §3.2 P17. -->
        <service
            android:name=".companion.CompanionService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- v1.2: local DNS pipe (Agent B). The android:permission is what
             makes this a VpnService; the intent-filter is the VpnService
             action. Fail-open by design — a dead filter never black-holes
             the phone (DESIGN.md §5.4). MERGED: foregroundServiceType
             specialUse declared (the service starts foreground with
             FOREGROUND_SERVICE_TYPE_SPECIAL_USE). -->
        <service
            android:name=".dns.DnsVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- v1.2: DND change observation (Agent A). -->
        <service
            android:name=".dnd.DndListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
